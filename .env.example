# ==== HTTP ====
PORT=3100
# Chi de nginx/reverse proxy goi duoc (khuyen nghi khi cong khai); dat 0.0.0.0 neu can mo rong
HOST=127.0.0.1
# Bat buoc HTTPS khi cong khai. Dat ALLOW_HTTP=true chi khi chay local / dev
ALLOW_HTTP=false

# ==== Bao mat phien dang nhap ====
# Token phien song bao nhieu ngay (mac dinh 30)
SESSION_TTL_DAYS=30
# Chan do PIN: sai bao nhieu lan lien tiep thi khoa tai khoan, khoa bao nhieu phut
PIN_MAX_ATTEMPTS=5
PIN_LOCK_MINUTES=15
# Chan do mat khau dang ky (cua so truot trong bo nho)
REGISTER_MAX_ATTEMPTS=10
REGISTER_WINDOW_MINUTES=15

# ==== SQL Server ====
DB_SERVER=127.0.0.1
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=YourPassword
DB_NAME=your_database
# true khi SQL Server dung chung chi self-signed
DB_TRUST_SERVER_CERT=true
# neu bang cua ban KHONG co cot he thong _updated_at (san phẩm tu tao), dat gia tri rong: UPDATED_AT_COL=
UPDATED_AT_COL=_updated_at

# ==== Nghiep vu ====
# Mat khau cho POST /api/auth/register-access
REGISTER_PASSWORD=bt2607
# (Tuy chon) URL dich vu kiem tra chat luong anh khuon mat.
# Khong dat -> bo qua kiem tra chat luong khi dang ky khuon mat.
FACE_QUALITY_URL=
# (Tuy chon) URL dich vu so sanh khuon mat. Mong doi POST {imageUrl, registeredUrl} tra ve {matched: boolean}
# Khong dat -> xac thuc khuon mat se tra ve success=false (can tich hop dich vu AI cua ban)
FACE_COMPARE_URL=
